# Valores vacíos a propósito. No copies los de producción.
# PEGAZUZ_ENV=staging apaga webhooks y envíos reales a Meta.

PEGAZUZ_ENV=staging
DB_SYNCHRONIZE=false
DATABASE_URL=
REDIS_URL=
JWT_SECRET=

# El proyecto de Railway es el mismo que producción. En GitHub, no en este
# servicio, fija RAILWAY_ENVIRONMENT=staging, RAILWAY_SERVICE=pegazuz-backend-staging
# y los UUID de ese entorno y de ese servicio. El token de Actions tiene que
# ser un project token creado en el entorno staging.
# Respaldo. GitHub no extrae el volcado: Postgres-9yd6 no tiene proxy público
# y el túnel SSH no tiene una clave de host que se pueda verificar.
# El worker futuro es pegazuz-backup-staging y solo habla con
# postgres-9yd6.railway.internal. Sigue en plan-only: un cron no lo autoriza.
# El certificado en servicio ya incluye DNS:postgres-9yd6.railway.internal.
# root.crt se entrega después, solo como PEM público en el worker, nunca en
# este archivo. La clave privada del sobre no va aquí, ni en Railway, ni en
# GitHub. El proxy público de producción, para excluirlo, es
# caboose.proxy.rlwy.net.
# Candados de migración. STAGING_DB_HOST es solo el hostname, sin clave.
# No los dejes activos en el servicio. La migración es un comando aparte
# y no corre en cada publicación.
STAGING_DB_HOST=
CRM_MIGRATE_TARGET=
CRM_STAGING_MIGRATE=

# No la guardes en el servicio. Se pasa una sola vez:
# STAGING_SCHEMA_BOOTSTRAP=yes npm run bootstrap:staging
STAGING_SCHEMA_BOOTSTRAP=

# Déjalos vacíos. Staging no debe tener el token de WhatsApp de producción.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_NUMBER=
FB_PAGE_ACCESS_TOKEN=

# Sandbox del número de ensayo. Permanece apagado salvo STAGING_SANDBOX=on
# y el resto completo. No copies aquí los valores de producción.
# STAGING_OPENAI_API_KEY es independiente de OPENAI_API_KEY.
STAGING_SANDBOX=
STAGING_WHATSAPP_PHONE_NUMBER_ID=
STAGING_WHATSAPP_BUSINESS_ACCOUNT_ID=
STAGING_WHATSAPP_ACCESS_TOKEN=
STAGING_WHATSAPP_VERIFY_TOKEN=
STAGING_WHATSAPP_APP_SECRET=
STAGING_WHATSAPP_NUMBER=
STAGING_WHATSAPP_ALLOWLIST=
STAGING_OPENAI_API_KEY=
STAGING_OPENAI_MAX_REQUESTS=
STAGING_OPENAI_MAX_TOTAL_TOKENS=
STAGING_MEDIA_MAX_BYTES=
STAGING_MEDIA_TIMEOUT_MS=
