# Valores vacíos a propósito. No copies los de producción.
# PEGAZUZ_ENV=staging apaga webhooks y envíos reales a Meta.

PEGAZUZ_ENV=staging
DB_SYNCHRONIZE=false
DATABASE_URL=
REDIS_URL=
JWT_SECRET=

# Candados de migración. STAGING_DB_HOST es solo el hostname, sin clave.
STAGING_DB_HOST=
CRM_MIGRATE_TARGET=
CRM_STAGING_MIGRATE=

# Solo durante el primer arranque, con la base vacía, para crear el esquema.
# Después vuelve a DB_SYNCHRONIZE=false y borra STAGING_SCHEMA_BOOTSTRAP.
STAGING_SCHEMA_BOOTSTRAP=

# Déjalos vacíos. Staging no debe tener el token de WhatsApp de producción.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_NUMBER=
FB_PAGE_ACCESS_TOKEN=
