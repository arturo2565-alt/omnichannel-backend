{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pegazuz Repair Quote V1",
  "description": "Cotización humana de reparación sin fotografías. No comparte identificadores con AF ni CQ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quote_id",
    "revision",
    "recorded_at",
    "evidence",
    "photo_status",
    "source",
    "vehicle",
    "lines",
    "quoted_total_mxn",
    "conditions",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "quote_id": { "type": "string", "pattern": "^RQ-[0-9]{6}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "evidence": { "const": "text_only" },
    "photo_status": { "const": "not_provided" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_case_key",
        "opportunity_key",
        "prior_quote_id",
        "quoted_at"
      ],
      "properties": {
        "kind": { "const": "autofix_human_repair_quote" },
        "source_case_key": {
          "type": "string",
          "minLength": 4,
          "maxLength": 150
        },
        "opportunity_key": {
          "type": "string",
          "minLength": 4,
          "maxLength": 150
        },
        "prior_quote_id": {
          "type": ["string", "null"],
          "pattern": "^RQ-[0-9]{6}$"
        },
        "quoted_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "make",
        "make_evidence",
        "model",
        "model_evidence",
        "year",
        "year_evidence",
        "variant",
        "variant_evidence"
      ],
      "properties": {
        "make": { "type": ["string", "null"] },
        "make_evidence": { "enum": ["customer_provided", "unknown"] },
        "model": { "type": ["string", "null"] },
        "model_evidence": { "enum": ["customer_provided", "unknown"] },
        "year": {
          "type": ["integer", "null"],
          "minimum": 1900,
          "maximum": 2100
        },
        "year_evidence": { "enum": ["customer_provided", "unknown"] },
        "variant": { "type": ["string", "null"] },
        "variant_evidence": { "enum": ["customer_provided", "unknown"] }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/line" }
    },
    "quoted_total_mxn": { "type": "integer", "minimum": 1 },
    "conditions": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "status": { "const": "human_verified" }
  },
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "part", "role", "labor", "prices"],
      "properties": {
        "line_id": { "type": "string", "pattern": "^L[0-9]{2}$" },
        "part": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "enum": ["part", "labor"] },
        "labor": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["mount_and_paint", "paint", "repair"] }
          ]
        },
        "prices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quoted", "contracted", "collected"],
          "properties": {
            "quoted": {
              "type": "object",
              "additionalProperties": false,
              "required": ["amount_mxn", "validation"],
              "properties": {
                "amount_mxn": { "type": "integer", "minimum": 1 },
                "validation": { "const": "human_confirmed" }
              }
            },
            "contracted": { "$ref": "#/$defs/optionalPrice" },
            "collected": { "$ref": "#/$defs/optionalPrice" }
          }
        }
      }
    },
    "optionalPrice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount_mxn", "validation"],
          "properties": {
            "amount_mxn": { "type": "integer", "minimum": 1 },
            "validation": { "const": "human_confirmed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount_mxn", "validation"],
          "properties": {
            "amount_mxn": { "type": "null" },
            "validation": { "const": "not_provided" }
          }
        }
      ]
    }
  }
}
